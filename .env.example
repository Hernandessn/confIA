# Copie estas variáveis em: Netlify > Site configuration > Environment variables
# NUNCA commite um arquivo .env real com valores preenchidos.

# --- APIs de conteúdo ---
GROQ_API_KEY=
NEWSDATA_API_KEY=
CURRENTS_API_KEY=
OCRSPACE_API_KEY=

# Opcional — troca o modelo Groq usado em analyze.js
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Rate limiting (Upstash Redis REST) ---
# Crie um banco grátis em https://console.upstash.com/ (Redis > Create Database)
# e copie a "REST URL" e o "REST TOKEN" dele.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=